# PlatformIO
.pio/

# ESP-IDF generated per-env config (keep sdkconfig.defaults, ignore the rest)
sdkconfig
sdkconfig.*
!sdkconfig.defaults

# Managed components fetched by the IDF component manager
managed_components/
dependencies.lock

# macOS
.DS_Store

# KiCad (commit .kicad_pro/.kicad_sch/.kicad_pcb, libs, fab/, BOM/BUILD; ignore noise)
*-backups/
_autosave-*
*.kicad_pcb-bak
*.kicad_sch-bak
*.bak
fp-info-cache
*.lck
*~
# per-user local project state (uncomment to ignore if it churns):
*.kicad_prl

# Fab outputs belong in hardware/pcb-carrier/fab/ ONLY. KiCad's GUI defaults to
# writing them next to the project file, which silently creates a second, stale
# copy of the Gerbers -- exactly how someone etches the wrong artwork later.
# The project's plot output directory is set to ../fab/gerbers/, but ignore the
# old location too so a stray export can never be committed.
hardware/pcb-carrier/kbdrelay-carrier/*.gbr
hardware/pcb-carrier/kbdrelay-carrier/*.gbrjob
hardware/pcb-carrier/kbdrelay-carrier/*.drl
hardware/pcb-carrier/kbdrelay-carrier/*.gbl
hardware/pcb-carrier/kbdrelay-carrier/*.gtl
hardware/pcb-carrier/kbdrelay-carrier/*.gto
hardware/pcb-carrier/kbdrelay-carrier/*.gbo
hardware/pcb-carrier/kbdrelay-carrier/*.gts
hardware/pcb-carrier/kbdrelay-carrier/*.gbs
hardware/pcb-carrier/kbdrelay-carrier/*.gm1
hardware/pcb-carrier/kbdrelay-carrier/*.ps
hardware/pcb-carrier/kbdrelay-carrier/*.pdf

# editor swap files
*.swp
*.swo

# agent scratch snapshots
.agent-snapshots/
