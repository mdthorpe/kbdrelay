# Shared ESP-IDF defaults for all on-target envs.
#
# Console on the default UART0 (GPIO43 TX / GPIO44 RX). The S3-Zero's single
# USB-C port is used by the application itself — TinyUSB device on `tgt`, USB
# host on `kbd` — and the S3's USB-Serial/JTAG and USB-OTG share one PHY, so
# the console cannot live on USB-C while the app runs. Attach a USB-UART
# adapter to the UART pins to see logs (plan.md "Dev & Debug"). The SPI-only
# mock firmwares could switch their console back to USB-JTAG later.

# Force the console onto UART0 (TX/RX pads, GPIO43/44). The single USB-C is
# used by the application (TinyUSB device on tgt, USB host on kbd), so the
# console must NOT default to USB-Serial/JTAG. View logs via a USB-UART adapter.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# TinyUSB: enable exactly one HID interface (tgt presents a boot keyboard).
CONFIG_TINYUSB_HID_COUNT=1

# USB Host: support external hubs so keyboards that internally enumerate as a
# hub + HID device work (FR1.2). One hub level is enough for our case.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
